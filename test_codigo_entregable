import pytest
from codigo_entregable import Nave

# Definimos una lista que vamos a usar en los siguientes tests
@pytest.fixture
def lista_naves():
    # Creamos naves
    n1 = Nave('Enterprise')
    n2 = Nave('Serenity')		
    n3 = Nave('Nostromo')
    n4 = Nave('Rocinante')
    
    # Añadimos las piezas
    n1.piezas_rep = {'Motor':1, 'Filtro': 4}
    n2.piezas_rep = {'Placa':10}
    n3.piezas_rep = {'Pistones': 6}
    
    return [n1, n2, n3, n4]


def test_devolverNave(lista_naves):
    nave1 = lista_naves[0] 
    assert nave1.devuelveNave() == 'Nave: Enterprise'