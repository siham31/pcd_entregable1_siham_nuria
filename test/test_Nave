import pytest
from codigo_entregable import Nave, RepuestoDuplicadoError

# Definimos una lista que vamos a usar en los siguientes tests
@pytest.fixture
def nave():
    # Creamos naves
    return Nave('Enterprise')

# Definimos una lista de piezas de repuesto
@pytest.fixture
def piezas():
    return [
            'Filtro', 'Motor', 'Depósito','Reactor',
            'Antena', 'Sensor', 'Bláster', 'Torreta'
            ]

# Funcion: __init__
def test_creacion_Nave(nave):
    assert nave.nombre == 'Enterprise'

# Funcion: devuelveNave
def test_devuelveNave(nave):
    assert nave.devuelveNave() == 'Nave: Enterprise'

# Funcion: devuelvePiezasRep
def test_devuelvePiezasRep(nave, piezas):
    pieza = piezas[0]
    nave.anyadir_Pieza(pieza, 1)
    
    capsys.readouterr()
    
    pieza.devuelvePiezaRep()
    captured = capsys.readouterr()
    
    assert "Nombre: Filtro" in captured.out
    assert "Cantidad: 1" in captured.out
    

# Funcion anyadir_Pieza
def test_anyadir_Pieza(nave, piezas):
    for p in piezas:
        nave.anyadir_Pieza(p, 1)
    
    assert 'Filtro' in nave.piezas_rep
    assert 'Torreta' in nave.piezas_rep
    assert nave.piezas_rep['Filtro'] == 1
    assert nave.piezas_rep['Torreta'] == 1
    assert len(nave.piezas_rep) == len(piezas)

def test_error_anyadir_Pieza_cantidad_negativa(nave, piezas):
    with pytest.raises(ValueError) as exinfo:
        nave.anyadir_Pieza(piezas[0], -1)
    
    assert str(exinfo.value) == "La cantidad introducida no puede ser negativa"

def test_error_anyadir_Pieza_repuesto_duplicado(nave, piezas):
    pieza = piezas[0]
    for p in piezas:
        nave.anyadir_Pieza(p, 1)
    
    with pytest.raises(RepuestoDuplicadoError) as exinfo:
        nave.anyadir_Pieza(pieza, 1)
    
    assert str(exinfo.value) == f"La pieza {pieza} ya está registrado"